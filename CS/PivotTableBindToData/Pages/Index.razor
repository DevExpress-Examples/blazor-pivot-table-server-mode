@page "/"

@using PivotTableBindToData.SalesDb
@using Microsoft.EntityFrameworkCore
@using DevExpress.Data.Linq
@inject IDbContextFactory<SalesContext> SalesContextFactory
@inject IConfiguration Configuration
@implements IAsyncDisposable
@using DevExpress.Blazor.PivotTable

@if (DataExists == true) {
<DxPivotTable Data="DataSource"
              VirtualScrollingEnabled="true">
    <Fields>
        <DxPivotTableField Field="StoreName" Area="@PivotTableArea.Row" SummaryType="PivotTableSummaryType.CountDistinct" />
        <DxPivotTableField Field="SaleDate" Area="@PivotTableArea.Column" GroupInterval="@PivotTableGroupInterval.DateYear" Caption="Year" />
        <DxPivotTableField Field="SaleDate" Area="@PivotTableArea.Column" GroupInterval="@PivotTableGroupInterval.DateQuarter" Caption="Quarter">
            <ValueTemplate>
                <span>@($"Q{context.Text}")</span>
            </ValueTemplate>
        </DxPivotTableField>
        <DxPivotTableField Field="Amount" Area="@PivotTableArea.Data" SummaryType="@PivotTableSummaryType.Sum" />
        <DxPivotTableField Field="@nameof(Sale.SaleId)" Caption="Count" Area="PivotTableArea.Data" SummaryType="PivotTableSummaryType.Count" />
    </Fields>
</DxPivotTable>
}
else if (DataExists == false) {
    <div class="generate-data-container">
        <p>The Sales table (or the database file) was not found.</p>
        <DxButton Text="Generate data" Enabled="@(!IsGenerating)" Click="@GenerateDataAsync" />
        @if (IsGenerating) {
            <p>Generating 1,000,000 rows, please wait...</p>
        }
    </div>
}

@code {
    SalesContext SalesContext { get; set; }
    EntityServerModeSource DataSource { get; set; }
    bool? DataExists { get; set; }
    bool IsGenerating { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (!firstRender || SalesContext != null)
            return;

        SalesContext = await SalesContextFactory.CreateDbContextAsync();
        SalesContext.ChangeTracker.QueryTrackingBehavior = QueryTrackingBehavior.NoTracking;

        DataExists = await SalesDataGenerator.SalesTableExistsAsync(SalesContext);
        if (DataExists == true)
            CreateDataSource();

        StateHasChanged();
    }

    async Task GenerateDataAsync() {
        IsGenerating = true;
        StateHasChanged();

        await SalesDataGenerator.GenerateAsync(SalesContext, Configuration.GetValue("DataProvider", DataProviders.SQLite.ToString()));

        CreateDataSource();
        DataExists = true;
        IsGenerating = false;
        StateHasChanged();
    }

    void CreateDataSource() {
        DataSource = new EntityServerModeSource {
            QueryableSource = SalesContext.Sales,
            KeyExpression = nameof(Sale.SaleId)
        };
    }

    public async ValueTask DisposeAsync() {
        DataSource?.Dispose();
        if (SalesContext != null)
            await SalesContext.DisposeAsync();
    }
}
